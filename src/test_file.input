fn main() {
      println!("true && true: {}", true && true);
      println!("true && false: {}", true && false);
      println!("true || false: {}", true || false);
      println!("!true: {}", !true);
      println!("10 > 5: {}", 10 > 5);
      println!("5 >= 5: {}", 5 >= 5);
      println!("3 < 8: {}", 3 < 8);
      println!("4 <= 4: {}", 4 <= 4);
      println!("5 == 5: {}", 5 == 5);
      println!("6 != 7: {}", 6 != 7);
    }